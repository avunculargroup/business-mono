# Supabase — required for all environments
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenRouter — optional. Read server-side only (never exposed to the browser) to
# show the credits balance on the dashboard. The OpenRouterCredits card degrades
# to "Credits unavailable" when unset. Use a dedicated key so it can be revoked
# independently of the agent server's key.
OPENROUTER_API_KEY=your-openrouter-key

# OpenAI — optional. Server-side only, and used for exactly one thing: embedding
# a single search query so /news/podcasts can run vector_search_transcripts
# (apps/web/lib/openaiEmbedding.ts). The agent server owns the write side of the
# embedding pipeline; this is the read side. Must be the same model and
# dimensions the ingestion used, which @platform/shared pins, or the vectors are
# not comparable. Podcast search fails with a humane message when unset.
# OPENAI_API_KEY=sk-...

# Research inbound domain — optional. The domain email newsletter sources are
# subscribed at: research+{slug}@<domain>. NEXT_PUBLIC_ because the source form
# renders the inbound-address preview client-side as you type; the server action
# reads the same value, so the two cannot drift. Defaults to btreasury.com.au.
# NEXT_PUBLIC_RESEARCH_INBOUND_DOMAIN=btreasury.com.au

# LinkedIn OAuth — optional, required only to connect a LinkedIn account from
# /settings/integrations. Both values come from a LinkedIn developer app. The
# redirect URI is derived from the request origin
# (<origin>/api/integrations/linkedin/callback) rather than configured here, so
# register that exact path against the app for every origin you use — including
# Vercel preview deployments, whose origin differs per deploy. The "Connect"
# flow redirects back with ?error=not_configured when the client ID is unset.
# LINKEDIN_CLIENT_ID=...
# LINKEDIN_CLIENT_SECRET=...
