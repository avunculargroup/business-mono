# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id
# Postgres connection string for Mastra's internal thread/memory storage (PostgresStore).
# This is NOT the Supabase JS client — that uses SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (HTTPS).
#
# Recommended (no IPv6 issues): add a Railway Postgres plugin to your project, then set:
# MASTRA_DB_URL=${{Postgres.DATABASE_URL}}
# Railway-internal Postgres is always IPv4 and on the private network.
#
# Alternative: Supabase direct connection (db.[ref].supabase.co:5432) — only works if the
# Supabase IPv4 Add-On is enabled (Dashboard → Settings → Add-Ons → IPv4 address, ~$4/mo).
# Without it, newer Supabase projects resolve to IPv6 only, which Railway cannot reach.
#
MASTRA_DB_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway
# Accepted as a fallback when MASTRA_DB_URL is not set. Prefer MASTRA_DB_URL —
# this one exists for older deployments that predate the rename.
# SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# AI provider — choose ONE of the following:

# Option 1: Anthropic (direct) — default
ANTHROPIC_API_KEY=sk-ant-...
# Override model (optional, default: anthropic/claude-sonnet-4-5)
# ANTHROPIC_MODEL=anthropic/claude-sonnet-4-5

# Option 2: OpenRouter (access any model via a single API key)
# OPENROUTER_API_KEY=sk-or-v1-...
# To use Claude via OpenRouter:
#   OPENROUTER_MODEL=anthropic/claude-sonnet-4-5
# To use another model via OpenRouter (e.g. GPT-4o):
#   ANTHROPIC_MODEL=openai/gpt-4o-mini
# (Do not set ANTHROPIC_MODEL for Claude models; use OPENROUTER_MODEL instead)

# OpenAI (embeddings)
OPENAI_API_KEY=sk-...

# Deepgram (transcription)
DEEPGRAM_API_KEY=...

# Telnyx (phone recordings)
TELNYX_API_KEY=KEY...
TELNYX_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Zoom (video recordings)
ZOOM_WEBHOOK_SECRET_TOKEN=...

# Researcher (web search and crawling)
TAVILY_API_KEY=tvly-...
FIRECRAWL_API_KEY=fc-...

# GitHub (ecosystem signals — github_release / github_advisory watches).
# Optional but effectively required in production: the anonymous REST rate
# limit is 60 requests/hour, which a handful of watches exhausts in one sweep.
# A fine-grained token with public read access is enough — the watches only
# read public releases and advisories.
# GITHUB_TOKEN=github_pat_...

# FRED (economic indicators — US series: policy rate, M2, CPI). Free key from
# fred.stlouisfed.org/docs/api/api_key.html. Indicators with provider='fred'
# fail their poll with "FRED_API_KEY is not set" when unset; other providers
# (RBA, ABS, OECD, Stooq, Gold API) are unaffected.
# FRED_API_KEY=...

# LlamaParse (report ingestion — OCR fallback only). Optional: the report_watch
# extraction waterfall reads the PDF text layer with unpdf first, and only calls
# LlamaParse for pages that fail the quality gate, on sources with ocr_enabled
# set (off by default) and capped at the source's ocr_page_limit. Unset, a
# scanned report is still acquired, stored and surfaced in the feed — it is
# marked needs_review with no extracted text rather than lost. Key from
# cloud.llamaindex.ai.
# LLAMA_CLOUD_API_KEY=llx-...

# BGeometrics (on-chain indicators — realised_cap). Free self-serve key, no
# card, at portal.bgeometrics.com. Other on-chain providers (mempool.space,
# Coin Metrics community, CoinGecko, alternative.me) are keyless.
BGEOMETRICS_API_KEY=...

# News digest email (the news_curation routine emails the team after each run).
# The sender credential is reused from the avuncular@fastmail.com row in the
# fastmail_accounts table (sent as the hq@btreasury.com.au identity), so no
# extra secret is needed. The only optional setting is the web app base URL,
# used to make the digest's "More news" link clickable from an inbox; the
# button is omitted when unset.
# WEB_APP_URL=https://your-app.vercel.app

# Signal CLI (sidecar on Railway private network)
SIGNAL_CLI_API_URL=http://signal-cli.railway.internal:8080
SIGNAL_CLI_NUMBER=+61400000000
# For local development, override with: SIGNAL_CLI_API_URL=http://localhost:8080
# Kill switch for the Signal listener — set to "false" to skip subscribing on
# boot (useful when running locally without a registered Signal number).
# SIGNAL_LISTENER_ENABLED=true

# Mastra Cloud observability (optional) — when set, the CloudExporter ships
# traces to https://observability.mastra.ai alongside the local
# DefaultExporter. The CloudExporter self-disables if this is unset, so the
# variable is only needed in production.
# MASTRA_CLOUD_ACCESS_TOKEN=...
# Optional project-scoping for Mastra Cloud (otherwise endpoint-derived):
# MASTRA_PROJECT_ID=...

# Local (DefaultExporter) trace buffering. On by default outside production and
# OFF in production, because the in-memory buffer is unbounded and pinned the
# small Railway heap at its ceiling — the recurring "heap out of memory" crash.
# Set to "true" to opt in for a one-off production trace-capture session. The
# agent_activity audit trail is unaffected either way.
# MASTRA_DEFAULT_EXPORTER=false

# Pino log level for the agent server. One of debug | info | warn | error.
# LOG_LEVEL=info

# Web app base URL, used to build the clickable "review in HQ" link in the
# Signal message sent when a newsletter run completes. The link is omitted when
# unset; nothing else depends on it. (Distinct from WEB_APP_URL above, which the
# news digest email uses — they are read by different code paths.)
# PLATFORM_URL=https://your-app.vercel.app

# Listener kill switches. Both listeners run a startup backfill and then keep
# their embedding store in sync; set either to "false" to skip subscribing on
# boot, which is useful locally when you do not want the backfill spending
# OpenAI credits. Any other value (including unset) leaves the listener on.
# CONTENT_EMBEDDING_LISTENER_ENABLED=true
# VOICE_EMBEDDING_LISTENER_ENABLED=true

# Railway (set automatically in production)
PORT=3000
RAILWAY_PUBLIC_DOMAIN=your-service.railway.app
